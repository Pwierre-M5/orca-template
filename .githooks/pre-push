#!/usr/bin/env bash
# Arguments : <remote> <url> ; stdin : <local_ref> <local_sha> <remote_ref> <remote_sha>
set -euo pipefail
. "$(dirname "$0")/branch-rules.sh"

zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  target="${remote_ref#refs/heads/}"
  if [[ "$local_sha" == "$zero" ]]; then
    echo "Refusé : suppression de branche distante '$target' sans accord. Demandez à Pierre." >&2
    status=1; continue
  fi
  [[ "$remote_ref" == refs/heads/* ]] || continue
  check_branch "$target" || { status=1; continue; }
  if [[ "$remote_sha" != "$zero" ]] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "Refusé : push non fast-forward sur '$target' (force-push). Demandez à Pierre." >&2
    status=1; continue
  fi
  if command -v gitleaks >/dev/null 2>&1; then
    range="$local_sha"; [[ "$remote_sha" != "$zero" ]] && range="$remote_sha..$local_sha"
    gitleaks detect --redact --no-banner --log-opts="$range" || {
      echo "Refusé : secret potentiel dans les commits poussés." >&2; status=1; }
  fi
done
exit $status
